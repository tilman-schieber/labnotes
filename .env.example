POSTGRES_DB=labnotes
POSTGRES_USER=labnotes
POSTGRES_PASSWORD=labnotes
POSTGRES_PORT=5432
DATABASE_URL=postgres://labnotes:labnotes@localhost:5432/labnotes
DEV_DATABASE_URL=postgres://labnotes:labnotes@localhost:5432/labnotes_dev
PROD_DATABASE_URL=postgres://labnotes:labnotes@localhost:5432/labnotes_prod
PORT=5174
AUTO_MIGRATE_ON_START=true
AUTO_SEED_ON_START=true
REVISION_COALESCE_SECONDS=120
# Where uploaded attachment bytes are stored (default: ./data/attachments)
# ATTACHMENTS_DIR=/var/lib/labnotes/attachments
# MAX_ATTACHMENT_BYTES=52428800
# TYPST_BIN=typst

# Background classification of entities written with `#`: head-noun rules, PubChem, the local
# density table. AUTO_CLASSIFY_GHS additionally fetches GHS hazard summaries from PubChem's
# view service (set to false where nothing may leave the network).
AUTO_CLASSIFY=true
AUTO_CLASSIFY_INTERVAL_SECONDS=120
AUTO_CLASSIFY_GAP_MS=400
AUTO_CLASSIFY_GHS=true

# Suggestion provider for saved experiments (server/lib/suggest/<name>.mjs). "none" returns
# nothing; this is the hook for a later language-model pass.
SUGGEST_PROVIDER=none
